# Copy this file to .env and fill in your own values.
# .env is ignored by git, so your password never gets committed.

PORT=3000

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=stayspot_db
PGUSER=postgres
PGPASSWORD=your_postgres_password

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGO_DB=stayspot
